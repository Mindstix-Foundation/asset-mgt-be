# ==============================================================================
# Asset Management Backend - Environment Configuration
# ------------------------------------------------------------------------------
# Copy this file to `.env` for development, or to `.env.production` on the
# server for production. NEVER commit a real `.env` to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# In production, use a strong, randomly-generated password and connect over
# localhost or a private network (never expose Postgres to the public internet).
DATABASE_URL="postgresql://user:password@localhost:5432/asset_management_db?schema=public"

# Optional Prisma / connection pool tuning
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT=30000

# ------------------------------------------------------------------------------
# JWT / Auth
# ------------------------------------------------------------------------------
# Generate a strong secret in production with: openssl rand -base64 64
JWT_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_STRING"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# NODE_ENV must be "production" on the production server.
NODE_ENV="development"
PORT=3000

# Set to "true" in production to expose Swagger at /api/docs.
# Recommended: leave this OFF (or unset) in production for security.
ENABLE_SWAGGER=false

# Log verbosity. Use "info" or "warn" in production, "debug" only in dev.
LOG_LEVEL="info"

# ------------------------------------------------------------------------------
# CORS / Frontend
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend.
# Example (production): "https://assets.example.com"
# Example (multiple):   "https://assets.example.com,https://admin.example.com"
CORS_ORIGIN="http://localhost:5173"

# Used in password reset emails and links sent to users.
FRONTEND_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# File Uploads
# ------------------------------------------------------------------------------
# Max upload size in BYTES. 10485760 = 10 MB.
MAX_FILE_SIZE=10485760

# Path on disk where uploads are stored. In production, this should be on a
# persistent volume that survives deploys.
UPLOAD_DEST="./uploads"

# ------------------------------------------------------------------------------
# Email (SMTP)
# ------------------------------------------------------------------------------
# For Gmail, use an App Password (not your account password):
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"Asset Management" <your-email@example.com>'
