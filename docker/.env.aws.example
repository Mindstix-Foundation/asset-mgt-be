# ==============================================================================
# Asset Management - AWS environment template
# ------------------------------------------------------------------------------
# Copy to `.env` on the EC2 instance and fill in the values. Use Secrets
# Manager / SSM Parameter Store for real secrets and inject them with a
# bootstrap script — DO NOT commit a real `.env` to git.
# ==============================================================================

# ---- RDS PostgreSQL ---------------------------------------------------------
# Use the RDS endpoint hostname, not an IP. Always force TLS with sslmode=require.
DATABASE_URL=postgresql://asset_user:CHANGE_ME@asset-mgt-prod.abc123.us-east-1.rds.amazonaws.com:5432/asset_management_db?schema=public&sslmode=require

# ---- Backend secrets --------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=7d

# ---- Public hostname --------------------------------------------------------
# The domain users hit (the one pointing at the ALB). Used for CORS + email links.
CORS_ORIGIN=https://assets.example.com
FRONTEND_URL=https://assets.example.com

# Same-origin API path (nginx in the frontend container proxies /api to backend).
VITE_API_BASE_URL=/api

# ---- App tuning -------------------------------------------------------------
ENABLE_SWAGGER=false
LOG_LEVEL=info
MAX_FILE_SIZE=10485760

# ---- ALB target port (where docker-compose binds nginx on the host) --------
FRONTEND_PORT=8080

# ---- SMTP (use SES SMTP credentials in production) -------------------------
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIA...
SMTP_PASS=BPa...
SMTP_FROM="Asset Management <noreply@example.com>"
