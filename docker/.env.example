# ==============================================================================
# Asset Management - docker-compose environment
# ------------------------------------------------------------------------------
# Copy this file to `.env` (in the same folder as docker-compose.yml) and edit
# the values. NEVER commit a real `.env` to git.
#
# Host-based routing (shared sre-nginx): add to /etc/hosts:
#   127.0.0.1 assets.mindstix.com attendance.mindstix.com
# ==============================================================================

# ---- Postgres ---------------------------------------------------------------
POSTGRES_USER=asset_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=asset_management_db
POSTGRES_PORT=5432

# ---- Ports exposed on the host ---------------------------------------------
# Frontend (nginx)  -> http://localhost:${FRONTEND_PORT}
# Backend  (NestJS) -> http://localhost:${BACKEND_PORT}/api
FRONTEND_PORT=8080
BACKEND_PORT=3000

# ---- Backend ----------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Set to "true" to expose Swagger at /api/docs in production builds.
ENABLE_SWAGGER=false
LOG_LEVEL=info

# Allowed origins for CORS. Match the host you open in the browser.
CORS_ORIGIN=http://assets.mindstix.com:8080
FRONTEND_URL=http://assets.mindstix.com:8080

# Max upload size in bytes (10 MB default).
MAX_FILE_SIZE=10485760

# ---- SMTP (optional) --------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="Asset Management <your-email@example.com>"

# ---- Cookie security --------------------------------------------------------
# Leave "false" for local HTTP dev. Set to "true" for HTTPS production.
COOKIE_SECURE=false

# ---- Frontend build-time --------------------------------------------------
# Same-origin API path is the recommended setup (nginx proxies /api -> backend).
# Override only if you serve the API from a different domain.
VITE_API_BASE_URL=/api
