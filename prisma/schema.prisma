generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  isPlatform Boolean  @default(false) @map("is_platform")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users              User[]
  employees          Employee[]
  designations       Designation[]
  assetCategories    AssetCategory[]
  assetTypes         AssetType[]
  brands             Brand[]
  models             Model[]
  vendors            Vendor[]
  assets             Asset[]
  assetIssues        AssetIssue[]
  maintenanceSchedules MaintenanceSchedule[]
  assetEvents        AssetEvent[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  registrationRequests OrganizationRegistration[]
  softwareLicenses   SoftwareLicense[]

  @@index([isActive])
  @@index([isPlatform])
  @@map("tenants")
}

enum OrganizationRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Self-service org signup requests awaiting platform SUPER_ADMIN review
model OrganizationRegistration {
  id               Int                            @id @default(autoincrement())
  organizationName String                         @map("organization_name") @db.VarChar(100)
  adminFirstName   String                         @map("admin_first_name") @db.VarChar(50)
  adminLastName    String                         @map("admin_last_name") @db.VarChar(50)
  adminEmail       String                         @map("admin_email") @db.VarChar(255)
  adminUsername    String                         @map("admin_username") @db.VarChar(50)
  adminPasswordHash String                        @map("admin_password_hash") @db.VarChar(255)
  phone            String?                        @db.VarChar(20)
  message          String?                        @db.VarChar(500)
  status           OrganizationRegistrationStatus @default(PENDING)
  rejectionReason  String?                        @map("rejection_reason") @db.VarChar(500)
  reviewedBy       Int?                           @map("reviewed_by")
  reviewedAt       DateTime?                      @map("reviewed_at") @db.Timestamptz(6)
  tenantId         Int?                           @map("tenant_id")
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant?                        @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([organizationName])
  @@index([adminEmail])
  @@map("organization_registrations")
}

model User {
  id                          Int                   @id @default(autoincrement())
  tenantId                    Int                   @map("tenant_id")
  employeeId                  Int                   @unique @map("employee_id")
  username                    String                @unique @db.VarChar(50)
  passwordHash                String                @map("password_hash") @db.VarChar(255)
  isActive                    Boolean               @default(true) @map("is_active")
  lastLogin                   DateTime?             @map("last_login") @db.Timestamptz(6)
  createdBy                   Int?                  @map("created_by")
  createdAt                   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy                   Int?                  @map("updated_by")
  updatedAt                   DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  failedLoginAttempts         Int                   @default(0) @map("failed_login_attempts")
  lockedUntil                 DateTime?             @map("locked_until") @db.Timestamptz(6)
  refreshToken                String?               @map("refresh_token") @db.VarChar(500)
  refreshTokenExpires         DateTime?             @map("refresh_token_expires") @db.Timestamptz(6)
  roles                       String[]              @default([])
  tenant                      Tenant                @relation(fields: [tenantId], references: [id])
  createdAssetCategories      AssetCategory[]       @relation("AssetCategoryCreatedBy")
  updatedAssetCategories      AssetCategory[]       @relation("AssetCategoryUpdatedBy")
  assetEvents                 AssetEvent[]          @relation("AssetEventPerformedBy")
  createdAssetIssues          AssetIssue[]          @relation("AssetIssueCreatedBy")
  issuedAssets                AssetIssue[]          @relation("AssetIssuedBy")
  updatedAssetIssues          AssetIssue[]          @relation("AssetIssueUpdatedBy")
  createdAssetTypes           AssetType[]           @relation("AssetTypeCreatedBy")
  updatedAssetTypes           AssetType[]           @relation("AssetTypeUpdatedBy")
  createdAssets               Asset[]               @relation("AssetCreatedBy")
  updatedAssets               Asset[]               @relation("AssetUpdatedBy")
  createdBrands               Brand[]               @relation("BrandCreatedBy")
  updatedBrands               Brand[]               @relation("BrandUpdatedBy")
  createdEmployees            Employee[]            @relation("EmployeeCreatedBy")
  updatedEmployees            Employee[]            @relation("EmployeeUpdatedBy")
  createdDesignations         Designation[]         @relation("DesignationCreatedBy")
  updatedDesignations         Designation[]         @relation("DesignationUpdatedBy")
  createdMaintenanceSchedules MaintenanceSchedule[] @relation("MaintenanceScheduleCreatedBy")
  updatedMaintenanceSchedules MaintenanceSchedule[] @relation("MaintenanceScheduleUpdatedBy")
  createdModels               Model[]               @relation("ModelCreatedBy")
  updatedModels               Model[]               @relation("ModelUpdatedBy")
  notifications               Notification[]        @relation("UserNotifications")
  passwordResets              PasswordReset[]       @relation("PasswordResetUser")
  refreshSessions             RefreshSession[]      @relation("UserRefreshSessions")
  assignedRoles               UserRole[]            @relation("RoleAssignedBy")
  userRoles                   UserRole[]
  createdByUser               User?                 @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers                User[]                @relation("UserCreatedBy")
  employee                    Employee              @relation(fields: [employeeId], references: [id])
  updatedByUser               User?                 @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  updatedUsers                User[]                @relation("UserUpdatedBy")
  createdVendors              Vendor[]              @relation("VendorCreatedBy")
  updatedVendors              Vendor[]              @relation("VendorUpdatedBy")
  vendor                      Vendor?
  auditLogs                   AuditLog[]            @relation("AuditLogPerformedBy")
  createdSoftwareLicenses     SoftwareLicense[]     @relation("SoftwareLicenseCreatedBy")
  updatedSoftwareLicenses     SoftwareLicense[]     @relation("SoftwareLicenseUpdatedBy")

  @@index([tenantId])
  @@index([isActive, lastLogin])
  @@map("users")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([token, used, expiresAt])
  @@map("password_resets")
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([token, expiresAt])
  @@map("blacklisted_tokens")
}

model RefreshSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique @db.VarChar(500)
  deviceId  String?  @map("device_id") @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation("UserRefreshSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([token, expiresAt])
  @@map("refresh_sessions")
}

model Role {
  id        Int        @id @default(autoincrement())
  roleName  String     @unique @map("role_name") @db.VarChar(50)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  userRoles UserRole[]

  @@index([isActive])
  @@map("roles")
}

model UserRole {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  roleId         Int      @map("role_id")
  assignedBy     Int      @map("assigned_by")
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  isActive       Boolean  @default(true) @map("is_active")
  assignedByUser User     @relation("RoleAssignedBy", fields: [assignedBy], references: [id])
  role           Role     @relation(fields: [roleId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedBy])
  @@index([isActive])
  @@map("user_roles")
}

model Designation {
  id            Int        @id @default(autoincrement())
  tenantId      Int        @map("tenant_id")
  name          String     @db.VarChar(100)
  description   String?
  createdBy     Int        @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy     Int        @map("updated_by")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  createdByUser User       @relation("DesignationCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User       @relation("DesignationUpdatedBy", fields: [updatedBy], references: [id])
  employees     Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("designations")
}

model Employee {
  id            Int            @id @default(autoincrement())
  tenantId      Int            @map("tenant_id")
  employeeId    String         @map("employee_id") @db.Char(8)
  firstName     String         @map("first_name") @db.VarChar(50)
  lastName      String         @map("last_name") @db.VarChar(50)
  email         String         @unique @db.VarChar(255)
  phone         String?        @db.VarChar(15)
  dateOfBirth   DateTime?      @map("date_of_birth") @db.Date
  address       String?
  designationId Int?           @map("designation_id")
  status        EmployeeStatus @default(ACTIVE)
  createdBy     Int?           @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy     Int?           @map("updated_by")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  designation   Designation?   @relation(fields: [designationId], references: [id])
  assetIssues   AssetIssue[]
  softwareLicenses SoftwareLicense[] @relation("SoftwareLicenseAssignedTo")
  createdByUser User?          @relation("EmployeeCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("EmployeeUpdatedBy", fields: [updatedBy], references: [id])
  user          User?

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@index([designationId])
  @@index([status])
  @@index([firstName, lastName])
  @@map("employees")
}

model AssetCategory {
  id            Int         @id @default(autoincrement())
  tenantId      Int         @map("tenant_id")
  name          String      @db.VarChar(50)
  description   String?
  createdBy     Int         @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy     Int         @map("updated_by")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  createdByUser User        @relation("AssetCategoryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User        @relation("AssetCategoryUpdatedBy", fields: [updatedBy], references: [id])
  assetTypes    AssetType[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("asset_categories")
}

model AssetType {
  id                    Int           @id @default(autoincrement())
  tenantId              Int           @map("tenant_id")
  categoryId            Int           @map("category_id")
  name                  String        @db.VarChar(50)
  description           String?
  isActive              Boolean       @default(true) @map("is_active")
  createdBy             Int           @map("created_by")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy             Int           @map("updated_by")
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  specificationTemplate Json?         @map("specification_template")
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  category              AssetCategory @relation(fields: [categoryId], references: [id])
  createdByUser         User          @relation("AssetTypeCreatedBy", fields: [createdBy], references: [id])
  updatedByUser         User          @relation("AssetTypeUpdatedBy", fields: [updatedBy], references: [id])
  assets                Asset[]
  models                Model[]

  @@unique([tenantId, name, categoryId])
  @@index([tenantId])
  @@index([categoryId])
  @@index([isActive])
  @@map("asset_types")
}

model Brand {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  name          String   @db.VarChar(50)
  description   String?
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy     Int      @map("updated_by")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  assets        Asset[]
  createdByUser User     @relation("BrandCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User     @relation("BrandUpdatedBy", fields: [updatedBy], references: [id])
  models        Model[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

model Model {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @map("tenant_id")
  brandId        Int       @map("brand_id")
  assetTypeId    Int       @map("asset_type_id")
  name           String    @db.VarChar(100)
  specifications Json?
  createdBy      Int       @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy      Int       @map("updated_by")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  assets         Asset[]
  assetType      AssetType @relation(fields: [assetTypeId], references: [id])
  brand          Brand     @relation(fields: [brandId], references: [id])
  createdByUser  User      @relation("ModelCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User      @relation("ModelUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([tenantId, name, brandId, assetTypeId])
  @@index([tenantId])
  @@index([brandId])
  @@index([assetTypeId])
  @@map("models")
}

model Vendor {
  id            Int          @id @default(autoincrement())
  tenantId      Int          @map("tenant_id")
  name          String       @db.VarChar(100)
  contactPerson String?      @map("contact_person") @db.VarChar(100)
  email         String?      @db.VarChar(255)
  phone         String?      @db.VarChar(15)
  address       String?
  taxId         String?      @map("tax_id") @db.VarChar(50)
  panNumber     String?      @map("pan_number") @db.VarChar(10)
  notes         String?
  userId        Int?         @unique @map("user_id")
  status        VendorStatus @default(ACTIVE)
  createdBy     Int          @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy     Int          @map("updated_by")
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vendorType    VendorType   @default(SUPPLIER) @map("vendor_type")
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  assets        Asset[]
  createdByUser User         @relation("VendorCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User         @relation("VendorUpdatedBy", fields: [updatedBy], references: [id])
  user          User?        @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([name])
  @@index([vendorType])
  @@index([email])
  @@index([taxId])
  @@index([panNumber])
  @@index([status])
  @@map("vendors")
}

model Asset {
  id                   Int                   @id @default(autoincrement())
  tenantId             Int                   @map("tenant_id")
  assetId              String                @map("asset_id") @db.VarChar(20)
  assetTypeId          Int                   @map("asset_type_id")
  brandId              Int                   @map("brand_id")
  modelId              Int                   @map("model_id")
  serialNumber         String?               @map("serial_number") @db.VarChar(100)
  purchaseDate         DateTime?             @map("purchase_date") @db.Date
  purchaseCost         Decimal?              @map("purchase_cost") @db.Decimal(10, 2)
  vendorId             Int?                  @map("vendor_id")
  warrantyStartDate    DateTime?             @map("warranty_start_date") @db.Date
  warrantyEndDate      DateTime?             @map("warranty_end_date") @db.Date
  /// Depreciation settings (book value is computed, not stored)
  depreciationMethod   DepreciationMethod?   @map("depreciation_method")
  usefulLifeMonths     Int?                  @map("useful_life_months")
  salvageValue         Decimal?              @map("salvage_value") @db.Decimal(10, 2)
  /// Annual % for REDUCING_BALANCE, or ongoing % after year 1 for INITIAL_HIGH_REDUCING
  depreciationRatePercent Decimal?           @map("depreciation_rate_percent") @db.Decimal(5, 2)
  /// Year-1 % for INITIAL_HIGH_REDUCING only
  firstYearDepreciationRatePercent Decimal?  @map("first_year_depreciation_rate_percent") @db.Decimal(5, 2)
  location             AssetLocation?
  condition            AssetCondition        @default(NEW)
  status               AssetStatus           @default(NON_ASSIGNED)
  notes                String?
  retirementDate       DateTime?             @map("retirement_date") @db.Date
  retirementReason     String?               @map("retirement_reason")
  reactivationDate     DateTime?             @map("reactivation_date") @db.Date
  reactivationReason   String?               @map("reactivation_reason")
  qrCode               String?               @map("qr_code") @db.VarChar(255)
  imageUrl             String?               @map("image_url") @db.VarChar(500)
  createdBy            Int                   @map("created_by")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy            Int                   @map("updated_by")
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  retirementNotes      String?               @map("retirement_notes")
  specifications       Json?
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  assetEvents          AssetEvent[]          @relation("AssetEvents")
  assetIssues          AssetIssue[]
  assetType            AssetType             @relation(fields: [assetTypeId], references: [id])
  brand                Brand                 @relation(fields: [brandId], references: [id])
  createdByUser        User                  @relation("AssetCreatedBy", fields: [createdBy], references: [id])
  model                Model                 @relation(fields: [modelId], references: [id])
  updatedByUser        User                  @relation("AssetUpdatedBy", fields: [updatedBy], references: [id])
  vendor               Vendor?               @relation(fields: [vendorId], references: [id])
  maintenanceSchedules MaintenanceSchedule[]

  @@unique([tenantId, assetId])
  @@unique([tenantId, serialNumber])
  @@index([tenantId])
  @@index([assetTypeId])
  @@index([brandId])
  @@index([modelId])
  @@index([vendorId])
  @@index([status])
  @@index([condition])
  @@index([status, condition])
  @@index([retirementDate])
  @@index([reactivationDate])
  @@index([warrantyEndDate])
  @@unique([qrCode])
  @@map("assets")
}

/// Software / SaaS license tracking with expiry reminders
model SoftwareLicense {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  name          String    @db.VarChar(150)
  vendorName    String?   @map("vendor_name") @db.VarChar(100)
  licenseKey    String?   @map("license_key") @db.VarChar(255)
  seats         Int?
  purchaseDate  DateTime? @map("purchase_date") @db.Date
  purchaseCost  Decimal?  @map("purchase_cost") @db.Decimal(10, 2)
  startDate     DateTime? @map("start_date") @db.Date
  expiryDate    DateTime  @map("expiry_date") @db.Date
  /// Employee responsible for this license (e.g. team lead)
  assignedToId  Int       @map("assigned_to_id")
  notes         String?
  isActive      Boolean   @default(true) @map("is_active")
  createdBy     Int       @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy     Int       @map("updated_by")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  assignedTo    Employee  @relation("SoftwareLicenseAssignedTo", fields: [assignedToId], references: [id])
  createdByUser User      @relation("SoftwareLicenseCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User      @relation("SoftwareLicenseUpdatedBy", fields: [updatedBy], references: [id])

  @@index([tenantId])
  @@index([expiryDate])
  @@index([isActive])
  @@index([assignedToId])
  @@index([tenantId, name])
  @@map("software_licenses")
}

model AssetIssue {
  id              Int              @id @default(autoincrement())
  tenantId        Int              @map("tenant_id")
  assetId         Int              @map("asset_id")
  employeeId      Int              @map("employee_id")
  issuedBy        Int              @map("issued_by")
  issueDate       DateTime         @map("issue_date") @db.Date
  issueCondition  AssetCondition?  @map("issue_condition")
  returnDate      DateTime?        @map("return_date") @db.Date
  returnCondition ReturnCondition? @map("return_condition")
  issueReason     String?          @map("issue_reason") @db.VarChar(100)
  returnReason    String?          @map("return_reason") @db.VarChar(100)
  notes           String?
  createdBy       Int              @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy       Int              @map("updated_by")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  issueTimestamp  DateTime         @default(now()) @map("issue_timestamp") @db.Timestamptz(6)
  returnTimestamp DateTime?        @map("return_timestamp") @db.Timestamptz(6)
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  asset           Asset            @relation(fields: [assetId], references: [id])
  createdByUser   User             @relation("AssetIssueCreatedBy", fields: [createdBy], references: [id])
  employee        Employee         @relation(fields: [employeeId], references: [id])
  issuedByUser    User             @relation("AssetIssuedBy", fields: [issuedBy], references: [id])
  updatedByUser   User             @relation("AssetIssueUpdatedBy", fields: [updatedBy], references: [id])

  @@index([tenantId])
  @@index([assetId])
  @@index([employeeId])
  @@index([issuedBy])
  @@index([issueDate])
  @@index([issueTimestamp])
  @@index([returnDate])
  @@index([returnTimestamp])
  @@index([issueCondition])
  @@index([returnCondition])
  @@map("asset_issues")
}

model MaintenanceSchedule {
  id                   Int                 @id @default(autoincrement())
  tenantId             Int                 @map("tenant_id")
  assetId              Int                 @map("asset_id")
  maintenanceType      MaintenanceTypeEnum @map("maintenance_type")
  scheduledDate        DateTime            @map("scheduled_date") @db.Timestamptz(6)
  frequencyDays        Int?                @map("frequency_days")
  description          String
  estimatedCost        Decimal?            @map("estimated_cost") @db.Decimal(10, 2)
  status               MaintenanceStatus   @default(SCHEDULED)
  actualStartDate      DateTime?           @map("actual_start_date") @db.Timestamptz(6)
  actualCompletionDate DateTime?           @map("actual_completion_date") @db.Timestamptz(6)
  actualCost           Decimal?            @map("actual_cost") @db.Decimal(10, 2)
  completionNotes      String?             @map("completion_notes")
  cancellationDate     DateTime?           @map("cancellation_date") @db.Timestamptz(6)
  cancellationReason   String?             @map("cancellation_reason")
  cancellationNotes    String?             @map("cancellation_notes")
  isActive             Boolean             @default(true) @map("is_active")
  createdBy            Int                 @map("created_by")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy            Int                 @map("updated_by")
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  asset                Asset               @relation(fields: [assetId], references: [id])
  createdByUser        User                @relation("MaintenanceScheduleCreatedBy", fields: [createdBy], references: [id])
  updatedByUser        User                @relation("MaintenanceScheduleUpdatedBy", fields: [updatedBy], references: [id])

  @@index([tenantId])
  @@index([assetId])
  @@index([maintenanceType])
  @@index([scheduledDate])
  @@index([status])
  @@index([isActive])
  @@index([actualCompletionDate])
  @@index([cancellationDate])
  @@map("maintenance_schedules")
}

model AssetEvent {
  id              Int            @id @default(autoincrement())
  tenantId        Int            @map("tenant_id")
  assetId         Int            @map("asset_id")
  eventType       AssetEventType @map("event_type")
  eventDate       DateTime       @map("event_date") @db.Timestamptz(6)
  performedBy     Int            @map("performed_by")
  fieldName       String?        @map("field_name") @db.VarChar(50)
  oldValue        String?        @map("old_value") @db.VarChar(500)
  newValue        String?        @map("new_value") @db.VarChar(500)
  metadata        Json?
  ipAddress       String?        @map("ip_address") @db.VarChar(45)
  userAgent       String?        @map("user_agent") @db.VarChar(500)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  asset           Asset          @relation("AssetEvents", fields: [assetId], references: [id], onDelete: Cascade)
  performedByUser User           @relation("AssetEventPerformedBy", fields: [performedBy], references: [id])

  @@index([tenantId])
  @@index([assetId])
  @@index([eventType])
  @@index([eventDate])
  @@index([performedBy])
  @@index([fieldName])
  @@map("asset_events")
}

model Notification {
  id        Int              @id @default(autoincrement())
  tenantId  Int              @map("tenant_id")
  userId    Int              @map("user_id")
  type      NotificationType @map("type")
  title     String           @db.VarChar(200)
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  data      Json?            @map("data")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  user      User             @relation("UserNotifications", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id            Int         @id @default(autoincrement())
  tenantId      Int         @map("tenant_id")
  tableName     String      @map("table_name") @db.VarChar(50)
  recordId      Int         @map("record_id")
  action        AuditAction
  entityLabel   String?     @map("entity_label") @db.VarChar(255)
  summary       String?     @db.VarChar(500)
  oldValues     Json?       @map("old_values")
  newValues     Json?       @map("new_values")
  changedFields String[]    @map("changed_fields")
  metadata      Json?
  userId        Int         @map("user_id")
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  userAgent     String?     @map("user_agent") @db.VarChar(500)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  user          User        @relation("AuditLogPerformedBy", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tableName, recordId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

